def checkAndInitChatDolphinDB() {
    dbPath = "dfs://chat_dolphindb"

    // 1. 检查并初始化数据库 (TSDB 支持 BLOB)
    if(!existsDatabase(dbPath)){
        monthRanges = 2024.01M..2035.12M
        database(dbPath, VALUE, monthRanges, engine='TSDB')
    }

    db = database(dbPath)

    // 2. chats 表
    if(!existsTable(dbPath, "chats")){
        chatsSchema = table(
            1:0,
            [
                `chatId, `workspaceId, `username, `title, `providerId, `modelId, `agentId,
                `authHeader, `createTime, `updateTime, `isDeleted
            ],
            [
                UUID, UUID, SYMBOL, STRING, SYMBOL, SYMBOL, SYMBOL,
                STRING, TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(chatsSchema, "chats", `createTime, sortColumns=[`chatId, `createTime])
    }
    // 3. messages 表
    if(!existsTable(dbPath, "messages")){
        messagesSchema = table(
            1:0,
            [
                `msgId, `chatId, `username, `createTime, `updateTime,
                `role, `messageType, `content, `reasoning_content, `content_object, `msgIndex
            ],
            [
                UUID, UUID, SYMBOL, TIMESTAMP, TIMESTAMP,
                SYMBOL, STRING, BLOB, BLOB, BLOB, INT
            ]
        )
        db.createPartitionedTable(messagesSchema, "messages", `createTime, sortColumns=[`chatId, `createTime])
    }

    // 4. ai_providers 表
    if(!existsTable(dbPath, "ai_providers")){
        providersSchema = table(
            1:0,
            [
                `providerId, `providerName, `baseUrl, `apiKey, `description, `headers,
                `defaultModelId, `createTime, `updateTime, `isEnabled
            ],
            [
                SYMBOL, STRING, STRING, STRING, STRING, STRING,
                STRING, TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(providersSchema, "ai_providers", `createTime, sortColumns=[`providerId, `createTime])
    }
    // 5. ai_models 表
    if(!existsTable(dbPath, "ai_models")){
        modelsSchema = table(
            1:0,
            [
                `modelId, `providerId, `modelName, `modelCode, `contextWindow, `supportTool,
                `temperature, `topP, `maxTokens, `extraConfig, `isDefault,
                `createTime, `updateTime, `isEnabled
            ],
            [
                SYMBOL, SYMBOL, STRING, STRING, INT, BOOL,
                DOUBLE, DOUBLE, INT, STRING, BOOL,
                TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(modelsSchema, "ai_models", `createTime, sortColumns=[`modelId, `createTime])
    }
    // 6. skills 表
    if(!existsTable(dbPath, "skills")){
        skillsSchema = table(
            1:0,
            [
                `skillId, `skillName, `description,
                `script, `createTime, `updateTime, `isEnabled
            ],
            [
                SYMBOL, STRING, STRING,
                BLOB, TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(skillsSchema, "skills", `createTime, sortColumns=[`skillId, `createTime])
    }

    // 7. workspaces 表
    if(!existsTable(dbPath, "workspaces")){
        workspacesSchema = table(
            1:0,
            [
                `id, `name, `current_state, `createTime, `updateTime, `isDeleted
            ],
            [
                UUID, STRING, BLOB, TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(workspacesSchema, "workspaces", `createTime, sortColumns=[`id, `createTime])
    }

    // 8. steps 表
    if(!existsTable(dbPath, "steps")){
        stepsSchema = table(
            1:0,
            [
                `id, `chatId, `stepIndex, `content, `checked, `active, `createTime, `updateTime, `isDeleted
            ],
            [
                UUID, UUID, INT, STRING, BOOL, BOOL, TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(stepsSchema, "steps", `createTime, sortColumns=[`chatId, `createTime])
    }

    // 9. vfs 表
    if(!existsTable(dbPath, "vfs")){
        vfsSchema = table(
            1:0,
            [
                `id, `workspaceId, `path, `content, `createTime, `updateTime, `isDeleted
            ],
            [
                UUID, UUID, STRING, BLOB, TIMESTAMP, TIMESTAMP, BOOL
            ]
        )
        db.createPartitionedTable(vfsSchema, "vfs", `createTime, sortColumns=[`workspaceId, `path, `createTime])
    }

    // 10. 返回健康状态字典
    return dict(`status`db_ready`timestamp, ["ok", true, now()])
}

checkAndInitChatDolphinDB()
